{
  "name": "tn5250-desktop",
  "description": "Standalone 5250 terminal emulator for IBM i (AS/400). Native app for Windows and Linux, no runtime to install.",
  "version": "0.3.0",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/DerKyberTakt/tn5250-desktop.git"
  },
  "keywords": [
    "ibm i",
    "as400",
    "iseries",
    "5250",
    "tn5250",
    "terminal",
    "emulator",
    "desktop"
  ],
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.engine.json",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "go:check": "go vet . && go test .",
    "app:dev": "wails3 dev",
    "app:build": "npm run check && wails3 build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "jsdom": "^26.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "bugs": {
    "url": "https://github.com/DerKyberTakt/tn5250-desktop/issues"
  },
  "homepage": "https://github.com/DerKyberTakt/tn5250-desktop#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/legacy-modes": "^6.5.5",
    "@lezer/highlight": "^1.2.5",
    "@wailsio/runtime": "3.1.0",
    "codemirror": "^6.0.2"
  }
}
