{
  "name": "tn5250-desktop",
  "description": "Standalone 5250 terminal emulator for IBM i (AS/400). Native app for Windows and Linux, no runtime to install.",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/DerKyberTakt/tn5250-desktop.git"
  },
  "keywords": [
    "ibm i",
    "as400",
    "iseries",
    "5250",
    "tn5250",
    "terminal",
    "emulator",
    "desktop"
  ],
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.engine.json",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "go:check": "go vet . && go test .",
    "app:dev": "wails dev",
    "app:build": "npm run check && wails build -clean -trimpath"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "bugs": {
    "url": "https://github.com/DerKyberTakt/tn5250-desktop/issues"
  },
  "homepage": "https://github.com/DerKyberTakt/tn5250-desktop#readme",
  "engines": {
    "node": ">=20"
  }
}
