{
  "name": "tn5250-terminal",
  "displayName": "TN5250 Terminal for IBM i",
  "description": "5250 terminal emulator for IBM i (AS/400) that opens as a VS Code editor tab. Pure TypeScript TN5250 client, nothing else to install.",
  "version": "0.1.0",
  "publisher": "DerKyberTakt",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/DerKyberTakt/tn5250-terminal.git"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ibm i",
    "as400",
    "iseries",
    "5250",
    "tn5250",
    "terminal",
    "emulator"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onWebviewPanel:tn5250.terminal"
  ],
  "contributes": {
    "commands": [
      {
        "command": "tn5250.newConnection",
        "title": "New Connection",
        "category": "TN5250",
        "icon": "$(add)"
      },
      {
        "command": "tn5250.sortSessions",
        "title": "Sort Connections",
        "category": "TN5250",
        "icon": "$(list-ordered)"
      },
      {
        "command": "tn5250.refreshSessions",
        "title": "Refresh",
        "category": "TN5250",
        "icon": "$(refresh)"
      },
      {
        "command": "tn5250.connectPrevious",
        "title": "Connect to Previous IBM i",
        "category": "TN5250",
        "icon": "$(debug-start)"
      },
      {
        "command": "tn5250.openSettings",
        "title": "Settings",
        "category": "TN5250",
        "icon": "$(gear)"
      },
      {
        "command": "tn5250.editSession",
        "title": "Edit Session",
        "category": "TN5250",
        "icon": "$(edit)"
      },
      {
        "command": "tn5250.connectSession",
        "title": "Connect",
        "category": "TN5250",
        "icon": "$(plug)"
      },
      {
        "command": "tn5250.removeSession",
        "title": "Remove Session",
        "category": "TN5250",
        "icon": "$(trash)"
      },
      {
        "command": "tn5250.disconnect",
        "title": "Disconnect",
        "category": "TN5250"
      },
      {
        "command": "tn5250.reconnect",
        "title": "Reconnect",
        "category": "TN5250"
      },
      {
        "command": "tn5250.saveTrace",
        "title": "Save Session Trace (debug)",
        "category": "TN5250"
      },
      {
        "command": "tn5250.demoScreen",
        "title": "Open Demo Screen (no connection)",
        "category": "TN5250"
      },
      {
        "command": "tn5250.toggleScreenSize",
        "title": "Toggle 24x80 / 27x132 (demo screen)",
        "category": "TN5250"
      },
      {
        "command": "tn5250.toggleKeyDebug",
        "title": "Toggle Key Debug Overlay",
        "category": "TN5250"
      },
      {
        "command": "tn5250.shadowKey",
        "title": "Key handled by the 5250 terminal",
        "category": "TN5250"
      },
      {
        "command": "tn5250.importKmp",
        "title": "Import ACS Keyboard Map (.kmp)",
        "category": "TN5250"
      },
      {
        "command": "tn5250.setPassword",
        "title": "Set Sign-On Password (defaults)",
        "category": "TN5250"
      },
      {
        "command": "tn5250.printScreen",
        "title": "Print Screen (open as text)",
        "category": "TN5250"
      },
      {
        "command": "tn5250.newTab",
        "title": "New Tab (same session)",
        "category": "TN5250",
        "icon": "$(empty-window)"
      },
      {
        "command": "tn5250.disconnectAll",
        "title": "Disconnect All",
        "category": "TN5250"
      },
      {
        "command": "tn5250.duplicateSession",
        "title": "Duplicate Connection",
        "category": "TN5250",
        "icon": "$(copy)"
      },
      {
        "command": "tn5250.setCertPassphrase",
        "title": "Set TLS Certificate Passphrase (defaults)",
        "category": "TN5250"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "tn5250.shadowKey",
          "when": "false"
        },
        {
          "command": "tn5250.connectSession",
          "when": "false"
        },
        {
          "command": "tn5250.removeSession",
          "when": "false"
        },
        {
          "command": "tn5250.disconnect",
          "when": "activeWebviewPanelId == 'tn5250.terminal'"
        },
        {
          "command": "tn5250.reconnect",
          "when": "activeWebviewPanelId == 'tn5250.terminal'"
        },
        {
          "command": "tn5250.saveTrace",
          "when": "activeWebviewPanelId == 'tn5250.terminal'"
        },
        {
          "command": "tn5250.toggleScreenSize",
          "when": "activeWebviewPanelId == 'tn5250.terminal'"
        },
        {
          "command": "tn5250.toggleKeyDebug",
          "when": "activeWebviewPanelId == 'tn5250.terminal'"
        },
        {
          "command": "tn5250.editSession",
          "when": "false"
        },
        {
          "command": "tn5250.printScreen",
          "when": "activeWebviewPanelId == 'tn5250.terminal'"
        },
        {
          "command": "tn5250.duplicateSession",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "tn5250.newConnection",
          "when": "view == tn5250.sessions",
          "group": "navigation@1"
        },
        {
          "command": "tn5250.newTab",
          "when": "view == tn5250.sessions",
          "group": "navigation@1"
        },
        {
          "command": "tn5250.sortSessions",
          "when": "view == tn5250.sessions",
          "group": "navigation@2"
        },
        {
          "command": "tn5250.refreshSessions",
          "when": "view == tn5250.sessions",
          "group": "navigation@3"
        },
        {
          "command": "tn5250.connectPrevious",
          "when": "view == tn5250.sessions",
          "group": "navigation@4"
        },
        {
          "command": "tn5250.openSettings",
          "when": "view == tn5250.sessions",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "tn5250.connectSession",
          "when": "view == tn5250.sessions && viewItem == session",
          "group": "inline@1"
        },
        {
          "command": "tn5250.editSession",
          "when": "view == tn5250.sessions && viewItem == session",
          "group": "inline@2"
        },
        {
          "command": "tn5250.duplicateSession",
          "when": "view == tn5250.sessions && viewItem == session",
          "group": "inline@2"
        },
        {
          "command": "tn5250.removeSession",
          "when": "view == tn5250.sessions && viewItem == session",
          "group": "inline@3"
        }
      ]
    },
    "configuration": {
      "title": "TN5250 Terminal",
      "properties": {
        "tn5250.debug.keyOverlay": {
          "type": "boolean",
          "default": false,
          "description": "Show the last key events in the terminal tab (used to verify keyboard capture)."
        },
        "tn5250.sessions": {
          "type": "array",
          "default": [],
          "description": "Saved sessions shown in the TN5250 side bar.",
          "items": {
            "type": "object",
            "required": [
              "host"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "host": {
                "type": "string"
              }
            },
            "additionalProperties": true,
            "description": "Only values that differ from the defaults are stored."
          }
        },
        "tn5250.sessionsSort": {
          "type": "string",
          "enum": [
            "manual",
            "name"
          ],
          "default": "manual",
          "description": "Order of the connections in the side bar."
        },
        "tn5250.connection.defaultHost": {
          "default": "",
          "type": "string",
          "description": "Host used by Connect to Previous when no connection is saved."
        },
        "tn5250.connection.defaultPort": {
          "default": 23,
          "type": "integer",
          "description": "TN5250: port. Set it on the TN5250 Settings page."
        },
        "tn5250.connection.tls": {
          "default": false,
          "type": "boolean",
          "description": "TN5250: tls. Set it on the TN5250 Settings page."
        },
        "tn5250.connection.verifyCertificate": {
          "default": true,
          "type": "boolean",
          "description": "TN5250: verify certificate. Set it on the TN5250 Settings page."
        },
        "tn5250.connection.deviceName": {
          "default": "",
          "type": "string",
          "description": "Workstation ID template: &COMPN computer name, &USERN user name, * letter per open tab, = digit per open tab (e.g. OD1N*=). Blank lets the host assign QPADEVnnnn."
        },
        "tn5250.connection.defaultScreenSize": {
          "default": "24x80",
          "type": "string",
          "enum": [
            "24x80",
            "27x132"
          ],
          "description": "TN5250: screen size. Set it on the TN5250 Settings page."
        },
        "tn5250.connection.defaultCodePage": {
          "default": 37,
          "type": "integer",
          "enum": [
            37,
            273,
            500,
            1140,
            1141,
            1142,
            1143,
            1144,
            1145,
            1146,
            1147,
            1148,
            1149
          ],
          "description": "TN5250: code page. Set it on the TN5250 Settings page."
        },
        "tn5250.connection.autoConnect": {
          "default": true,
          "type": "boolean",
          "description": "TN5250: auto connect. Set it on the TN5250 Settings page."
        },
        "tn5250.connection.autoReconnect": {
          "default": false,
          "type": "boolean",
          "description": "TN5250: auto reconnect. Set it on the TN5250 Settings page."
        },
        "tn5250.connection.connectTimeoutSeconds": {
          "default": 15,
          "type": "integer",
          "description": "TN5250: connect timeout seconds. Set it on the TN5250 Settings page."
        },
        "tn5250.connection.inactivityTimeoutMinutes": {
          "default": 0,
          "type": "integer",
          "description": "TN5250: inactivity timeout minutes. Set it on the TN5250 Settings page."
        },
        "tn5250.connection.keepAlive": {
          "default": true,
          "type": "boolean",
          "description": "TN5250: keep alive. Set it on the TN5250 Settings page."
        },
        "tn5250.connection.autoSignon": {
          "default": false,
          "type": "boolean",
          "description": "Fill the Sign On screen with the user ID and the password from the secret store."
        },
        "tn5250.connection.signonUser": {
          "default": "",
          "type": "string",
          "description": "TN5250: signon user. Set it on the TN5250 Settings page."
        },
        "tn5250.display.cursorStyle": {
          "default": "block",
          "type": "string",
          "enum": [
            "block",
            "underline"
          ],
          "description": "TN5250: cursor style. Set it on the TN5250 Settings page."
        },
        "tn5250.display.cursorBlink": {
          "default": true,
          "type": "boolean",
          "description": "TN5250: cursor blink. Set it on the TN5250 Settings page."
        },
        "tn5250.display.pointer": {
          "default": "default",
          "type": "string",
          "enum": [
            "default",
            "crosshair"
          ],
          "description": "TN5250: pointer. Set it on the TN5250 Settings page."
        },
        "tn5250.display.blinkText": {
          "default": "blink",
          "type": "string",
          "enum": [
            "blink",
            "hostColor",
            "mapped"
          ],
          "description": "TN5250: blink text. Set it on the TN5250 Settings page."
        },
        "tn5250.colors.blinkMapped": {
          "default": "#ff9040",
          "type": "string",
          "description": "TN5250: color blink mapped. Set it on the TN5250 Settings page."
        },
        "tn5250.display.ruleLine": {
          "default": false,
          "type": "boolean",
          "description": "TN5250: rule line. Set it on the TN5250 Settings page."
        },
        "tn5250.display.ruleLineStyle": {
          "default": "crosshair",
          "type": "string",
          "enum": [
            "crosshair",
            "horizontal",
            "vertical"
          ],
          "description": "TN5250: rule line style. Set it on the TN5250 Settings page."
        },
        "tn5250.display.ruleLineFollowsCursor": {
          "default": true,
          "type": "boolean",
          "description": "TN5250: rule line follows cursor. Set it on the TN5250 Settings page."
        },
        "tn5250.display.columnSeparators": {
          "default": "dot",
          "type": "string",
          "enum": [
            "dot",
            "line",
            "none"
          ],
          "description": "TN5250: column separators. Set it on the TN5250 Settings page."
        },
        "tn5250.display.showStatusLine": {
          "default": true,
          "type": "boolean",
          "description": "TN5250: show status line. Set it on the TN5250 Settings page."
        },
        "tn5250.font.autoFit": {
          "default": true,
          "type": "boolean",
          "description": "TN5250: auto fit. Set it on the TN5250 Settings page."
        },
        "tn5250.font.family": {
          "default": "",
          "type": "string",
          "description": "TN5250: font family. Set it on the TN5250 Settings page."
        },
        "tn5250.font.size": {
          "default": 14,
          "type": "integer",
          "description": "TN5250: font size. Set it on the TN5250 Settings page."
        },
        "tn5250.font.style": {
          "default": "plain",
          "type": "string",
          "enum": [
            "plain",
            "bold"
          ],
          "description": "TN5250: font style. Set it on the TN5250 Settings page."
        },
        "tn5250.font.rendering": {
          "default": "smooth",
